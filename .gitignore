__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
*.egg

# Jupyter Notebook
.ipynb_checkpoints

# MLOps & Feast
mlruns/
.feast/
feature_repo/data/

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
.terraformrc
terraform.rc

# IDE
.idea/
.vscode/
*.swp
*.swo

# Streamlit local secrets
.streamlit/secrets.toml

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Large data files — excluded from git
artifacts/*.csv
artifacts/*.parquet
data/
models/
spark-warehouse/
metastore_db/
derby.log/
*.crc
*.snappy.parquet
*.tar.gz
*.tgz
